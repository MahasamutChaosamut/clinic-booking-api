generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id           Int           @id @default(autoincrement())
  firstName    String        @map("first_name") @db.VarChar(50)
  lastName     String        @map("last_name") @db.VarChar(50)
  birthDate    DateTime      @map("birth_date") @db.Timestamptz
  phone        String?       @db.VarChar(20)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  appointments Appointment[]

  @@map("patients")
}

model Doctor {
  id           Int           @id @default(autoincrement())
  firstName    String        @map("first_name") @db.VarChar(50)
  lastName     String        @map("last_name") @db.VarChar(50)
  specialty    String        @db.VarChar(100)
  phone        String?       @db.VarChar(15)
  email        String?       @db.VarChar(100)
  userId       Int?          @unique @map("user_id")
  user         User?         @relation(fields: [userId], references: [id])
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz
  appointments Appointment[]

  @@map("doctors")
}

model Appointment {
  id            Int               @id @default(autoincrement())
  patientId     Int               @map("patient_id")
  patient       Patient           @relation(fields: [patientId], references: [id])
  doctorId      Int               @map("doctor_id")
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  appointmentAt DateTime          @map("appointment_at") @db.Timestamptz
  status        AppointmentStatus @default(booked)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  queue         Queue?

  @@index([patientId, appointmentAt])
  @@index([doctorId, appointmentAt])
  @@map("appointments")
}

model Queue {
  id            Int         @id @default(autoincrement())
  appointmentId Int         @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  queueDate     DateTime    @map("queue_date") @db.Timestamptz
  queueNumber   Int         @map("queue_number")
  status        QueueStatus @default(waiting)
  calledAt      DateTime?   @map("called_at") @db.Timestamptz
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@unique([queueDate, queueNumber])
  @@map("queue")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  doctor       Doctor?

  @@map("users")
}

enum AppointmentStatus {
  booked
  completed
  cancelled
  no_show
}

enum Role {
  admin
  doctor
  staff
}

enum QueueStatus {
  waiting
  called
  done
}
